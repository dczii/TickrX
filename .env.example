# TickrX web (Next.js) environment variables
# Copy to .env.local and fill in your Supabase project values.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Polygon.io — market data (optional; mock data is used when unset)
# Server-side REST key for snapshots/search:
POLYGON_API_KEY=
# Client-side key for the live-price WebSocket (optional):
NEXT_PUBLIC_POLYGON_API_KEY=
